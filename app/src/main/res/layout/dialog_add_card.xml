<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <EditText android:id="@+id/cardLabel" android:layout_width="match_parent"
        android:layout_height="56dp" android:hint="Card label"
        android:inputType="textCapSentences" android:maxLines="1"
        android:contentDescription="Card label" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Category" android:textStyle="bold" android:layout_marginTop="16dp" />

    <Spinner android:id="@+id/cardCategory" android:layout_width="match_parent"
        android:layout_height="56dp" android:contentDescription="Card category" />

    <ImageView android:id="@+id/imagePreview" android:layout_width="match_parent"
        android:layout_height="160dp" android:layout_marginTop="12dp"
        android:scaleType="centerCrop" android:visibility="gone"
        android:contentDescription="Selected card image" />

    <Button android:id="@+id/chooseImage" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_marginTop="12dp"
        android:text="Choose image from phone" />
</LinearLayout>
