<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:id="@+id/installedVersion" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="18sp"
        android:textStyle="bold" android:textColor="@color/navy" />

    <TextView android:id="@+id/updateStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:text="Check GitHub for a newer version of PEC Board."
        android:textSize="16sp" />

    <Button android:id="@+id/editCardFromSettings" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_marginTop="14dp"
        android:text="Edit Card"
        android:contentDescription="Add, edit, or remove a card" />

    <Button android:id="@+id/editCategoryFromSettings" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_marginTop="10dp"
        android:text="Edit Category"
        android:contentDescription="Create, rename, or remove a category" />

    <Button android:id="@+id/restoreDefaultCards" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_marginTop="10dp"
        android:text="Restore removed default cards"
        android:contentDescription="Restore removed default communication cards"
        android:visibility="gone" />

    <ProgressBar android:id="@+id/updateProgress" style="?android:attr/progressBarStyle"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
        android:visibility="gone" />

    <Button android:id="@+id/checkUpdates" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_marginTop="14dp"
        android:text="Check for updates" />

    <Button android:id="@+id/downloadUpdate" android:layout_width="match_parent"
        android:layout_height="56dp" android:layout_marginTop="10dp"
        android:text="Download update" android:visibility="gone" />
</LinearLayout>
</ScrollView>
