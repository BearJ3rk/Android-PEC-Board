<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/board_background"
    android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="My Voice Board" android:textColor="@color/navy"
        android:textSize="26sp" android:textStyle="bold" android:layout_marginBottom="12dp" />

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:layout_marginBottom="12dp">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/categories" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:singleSelection="true"
            android:selectionRequired="true" />
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/sentence_background" android:padding="12dp">
        <TextView android:id="@+id/sentence" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:minHeight="48dp" android:gravity="center_vertical"
            android:text="Tap a card to build a sentence" android:textColor="#51606F"
            android:textSize="20sp" android:contentDescription="Current sentence" />
        <Button android:id="@+id/speak" android:layout_width="wrap_content"
            android:layout_height="56dp" android:text="Speak" />
        <ImageButton android:id="@+id/undo" android:layout_width="56dp"
            android:layout_height="56dp" android:src="@android:drawable/ic_menu_revert"
            android:backgroundTint="@android:color/transparent" android:contentDescription="Remove last word" />
        <ImageButton android:id="@+id/clear" android:layout_width="56dp"
            android:layout_height="56dp" android:src="@android:drawable/ic_menu_delete"
            android:backgroundTint="@android:color/transparent" android:contentDescription="Clear sentence" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/board"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingTop="16dp" android:clipToPadding="false" />
</LinearLayout>
