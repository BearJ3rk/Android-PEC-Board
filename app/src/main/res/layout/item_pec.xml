<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="150dp"
    android:layout_margin="7dp" android:orientation="vertical" android:gravity="center"
    android:background="@drawable/card_background" android:padding="10dp"
    android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/symbol" android:layout_width="wrap_content"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center"
        android:textSize="52sp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:maxLines="2"
        android:textColor="@color/navy" android:textSize="19sp" android:textStyle="bold" />
</LinearLayout>
